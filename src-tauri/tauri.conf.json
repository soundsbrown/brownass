{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrownASS",
  "version": "0.4.0",
  "identifier": "com.soundsbrown.brownass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BrownASS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Tom Nuydens",
    "copyright": "© 2026 Tom Nuydens",
    "category": "Video",
    "shortDescription": "Subtitle editor for ASS subtitles",
    "longDescription": "Create and style ASS subtitles on a video's timeline with a live preview, and burn them in with ffmpeg.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
